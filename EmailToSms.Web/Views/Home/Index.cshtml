@{
    ViewData["Title"] = "Sistem Özeti";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1" style="letter-spacing: -0.025em;">Sistem Özeti</h3>
        <p class="text-muted mb-0" style="font-size: 0.95rem;">E-posta dinleme ve SMS iletim metrikleri.</p>
    </div>
    <div>
        <a asp-controller="EmailAccounts" asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fas fa-plus me-2"></i>Yeni Kanal Ekle
        </a>
    </div>
</div>

<!-- Metrik Kartları -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card stat-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted mb-1 fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Dinlenen Hesaplar</p>
                    <h2 class="mb-0 text-dark fw-bolder" style="font-size: 2.5rem; letter-spacing: -0.05em;">@ViewBag.AccountCount</h2>
                </div>
                <div class="bg-light p-3 rounded-3 border">
                    <i class="fas fa-inbox text-secondary fs-5"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card stat-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted mb-1 fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Aktif Kurallar</p>
                    <h2 class="mb-0 text-dark fw-bolder" style="font-size: 2.5rem; letter-spacing: -0.05em;">@ViewBag.RuleCount</h2>
                </div>
                <div class="bg-light p-3 rounded-3 border">
                    <i class="fas fa-filter text-secondary fs-5"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card stat-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <p class="text-muted mb-1 fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">İletilen SMS (Bugün)</p>
                    <h2 class="mb-0 text-dark fw-bolder" style="font-size: 2.5rem; letter-spacing: -0.05em;">@ViewBag.SmsCount</h2>
                </div>
                <div class="bg-light p-3 rounded-3 border">
                    <i class="fas fa-paper-plane text-secondary fs-5"></i>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    var recentLogs = ViewBag.RecentLogs as List<EmailToSms.Web.ViewModels.AuditLogViewModel>;
}

<!-- Log Tablosu -->
<div class="card border-0 stat-card">
    <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center rounded-top">
        <h6 class="mb-0 fw-bold text-dark">Son İşlem Aktiviteleri</h6>
        <button class="btn btn-sm btn-light border text-muted fw-semibold" onclick="location.reload()">
            <i class="fas fa-sync-alt me-1"></i> Yenile
        </button>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 200px;">Zaman Damgası</th>
                        <th style="width: 150px;">Aksiyon</th>
                        <th>Detay</th>
                        <th class="text-end pe-4" style="width: 100px;">Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @if (recentLogs != null && recentLogs.Any())
                    {
                        foreach (var log in recentLogs)
                        {
                            var timezoneId = string.Empty;
                            try { timezoneId = "Turkey Standard Time"; var tz = TimeZoneInfo.FindSystemTimeZoneById(timezoneId); }
                            catch { timezoneId = "Europe/Istanbul"; }
                            var turkeyTime = TimeZoneInfo.ConvertTimeFromUtc(log.CreatedAt, TimeZoneInfo.FindSystemTimeZoneById(timezoneId));

                            <tr>
                                <td class="ps-4">
                                    <span class="text-muted" style="font-size: 0.85rem; font-family: monospace;">@turkeyTime.ToString("dd.MM.yyyy HH:mm")</span>
                                </td>
                                <td>
                                    <span class="badge-soft-@(log.IsSuccess ? "success" : "danger")">
                                        @log.EventType
                                    </span>
                                </td>
                                <td class="text-dark" style="font-size: 0.9rem;">
                                    @log.Details
                                </td>
                                <td class="text-end pe-4">
                                    @if (log.IsSuccess)
                                    {
                                        <i class="fas fa-check text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-times text-danger"></i>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                Sistemde henüz kaydedilmiş bir işlem bulunmuyor.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white text-center py-3 border-top rounded-bottom">
        <a asp-controller="Logs" asp-action="Index" class="text-decoration-none fw-semibold" style="color: var(--primary-color); font-size: 0.9rem;">
            Tüm logları görüntüle &rarr;
        </a>
    </div>
</div>