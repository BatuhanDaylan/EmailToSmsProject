@model EmailToSms.Web.ViewModels.EmailAccountCreateViewModel
@{
    ViewData["Title"] = "Yeni E-Posta Ekle";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Yeni E-Posta Hesabı Bağla</h4>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning small">
                    <strong>Not:</strong> Bu işlemin gerçekleşmesi için Microsoft 365 Azure portalından aldığınız Tenant ID, Client ID ve Client Secret bilgilerini eksiksiz girmeniz gerekmektedir.
                </div>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="EmailAddress" class="form-label fw-bold">Okunacak E-Posta Adresi</label>
                        <input asp-for="EmailAddress" class="form-control" placeholder="ornek@sirket.com" />
                        <span asp-validation-for="EmailAddress" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TenantId" class="form-label fw-bold">Tenant ID (Dizin Kimliği)</label>
                        <input asp-for="TenantId" class="form-control" />
                        <span asp-validation-for="TenantId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ClientId" class="form-label fw-bold">Client ID (Uygulama Kimliği)</label>
                        <input asp-for="ClientId" class="form-control" />
                        <span asp-validation-for="ClientId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ClientSecret" class="form-label fw-bold">Client Secret (İstemci Gizli Anahtarı)</label>
                        <input asp-for="ClientSecret" class="form-control" type="password" />
                        <span asp-validation-for="ClientSecret" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">İptal ve Geri Dön</a>
                        <button type="submit" class="btn btn-success">Sisteme Bağla ve Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>