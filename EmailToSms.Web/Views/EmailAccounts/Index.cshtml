@model List<EmailToSms.Web.ViewModels.EmailAccountViewModel>
@{
    ViewData["Title"] = "E-Posta Kanalları";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1" style="letter-spacing: -0.025em;">E-Posta Kanalları</h3>
        <p class="text-muted mb-0" style="font-size: 0.95rem;">Sisteme bağlı Microsoft 365 hesaplarını yönetin.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="fas fa-plus me-2"></i>Yeni Kanal Bağla
    </a>
</div>

<div class="card stat-card border-0">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th class="ps-4">Kanal ID</th>
                            <th>E-Posta Adresi</th>
                            <th>Son Senkronizasyon</th>
                            <th>Durum</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted" style="font-family: monospace; font-size: 0.9rem;">
                                    #@account.Id
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-3 border" style="width: 36px; height: 36px;">
                                            <i class="fab fa-microsoft text-secondary"></i>
                                        </div>
                                        <span class="fw-semibold text-dark">@account.EmailAddress</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted" style="font-size: 0.85rem;">
                                        @(account.LastChecked == DateTime.MinValue ? "Henüz taranmadı" : account.LastChecked.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                                    </span>
                                </td>
                                <td>
                                    @if (account.IsActive)
                                    {
                                        <span class="badge-soft-success"><i class="fas fa-circle me-1" style="font-size: 8px;"></i> Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge-soft-danger"><i class="fas fa-circle me-1" style="font-size: 8px;"></i> Pasif</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm border rounded">
                                        <form asp-action="ToggleStatus" asp-route-id="@account.Id" method="post" class="m-0">
                                            <button type="submit" class="btn btn-sm btn-light border-0 text-secondary" title="@(account.IsActive ? "Durdur" : "Başlat")">
                                                <i class="fas @(account.IsActive ? "fa-pause" : "fa-play")"></i>
                                            </button>
                                        </form>
                                        <a asp-controller="ForwardingRules" asp-action="Index" asp-route-accountId="@account.Id" class="btn btn-sm btn-light border-0 text-primary border-start border-end" title="Kurallar">
                                            <i class="fas fa-filter"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@account.Id" class="btn btn-sm btn-light border-0 text-secondary border-end" title="Düzenle">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@account.Id" method="post" class="m-0 delete-form">
                                            <button type="button" class="btn btn-sm btn-light border-0 text-danger btn-delete" title="Sil">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3 border" style="width: 70px; height: 70px;">
                    <i class="fas fa-inbox fs-3 text-muted"></i>
                </div>
                <h6 class="text-dark fw-bold">Bağlı Kanal Bulunmuyor</h6>
                <p class="text-muted small mb-4">Sistemin çalışması için Microsoft 365 e-posta hesabınızı bağlayın.</p>
                <a asp-action="Create" class="btn btn-primary shadow-sm">Kanal Eklemeye Başla</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.btn-delete').on('click', function(e) {
                e.preventDefault();
                var form = $(this).closest('form');
                Swal.fire({
                    title: 'Emin misiniz?',
                    text: "Bu kanal ve ona bağlı tüm kurallar kalıcı olarak silinecektir.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#e2e8f0',
                    confirmButtonText: 'Evet, sil',
                    cancelButtonText: '<span style="color:#334155">İptal</span>'
                }).then((result) => {
                    if (result.isConfirmed) form.submit();
                });
            });
        });
    </script>
}