@model EmailToSms.Web.ViewModels.EmailAccountUpdateViewModel
@{
    ViewData["Title"] = "Kanal Ayarları";
}

<div class="row justify-content-center mt-3">
    <div class="col-lg-7">
        <div class="card stat-card border-0">
            <div class="card-body p-4 p-md-5">
                <div class="mb-4">
                    <h5 class="fw-bold text-dark mb-1">Kanalı Düzenle</h5>
                    <p class="text-muted small">Mevcut entegrasyon ayarlarını güncelliyorsunuz.</p>
                </div>

                <div class="alert bg-light border text-muted small mb-4 d-flex align-items-center rounded-3">
                    <i class="fas fa-shield-alt text-warning fs-5 me-3"></i>
                    <div>
                        Güvenlik sebebiyle şifreler (Secret) ekranda gösterilmez. Güncelleme yaparken mevcut veya yeni şifrenizi girmelisiniz.
                    </div>
                </div>

                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3"></div>

                    <div class="mb-4">
                        <label asp-for="EmailAddress" class="form-label">Okunacak E-Posta Adresi</label>
                        <input asp-for="EmailAddress" class="form-control bg-light border-0" />
                        <span asp-validation-for="EmailAddress" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="TenantId" class="form-label">Tenant ID</label>
                        <input asp-for="TenantId" class="form-control bg-light border-0" style="font-family: monospace;" />
                        <span asp-validation-for="TenantId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label asp-for="ClientId" class="form-label">Client ID</label>
                            <input asp-for="ClientId" class="form-control bg-light border-0" style="font-family: monospace;" />
                            <span asp-validation-for="ClientId" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ClientSecret" class="form-label">Client Secret <span class="text-danger">*</span></label>
                            <input asp-for="ClientSecret" class="form-control bg-light border-0 border-bottom border-warning" style="font-family: monospace;" type="password" placeholder="Zorunlu alan..." />
                            <span asp-validation-for="ClientSecret" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-5 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border text-secondary fw-semibold px-4">Vazgeç</a>
                        <button type="submit" class="btn btn-primary fw-semibold px-4">Değişiklikleri Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>