@model List<EmailToSms.Web.ViewModels.PhoneNumberViewModel>
@{
    ViewData["Title"] = "Telefon Rehberim";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="text-secondary fw-bold mb-0"><i class="fas fa-address-book me-2 text-success"></i>Kişisel Rehberim</h3>
        <p class="text-muted mb-0 small">Sisteme eklediğiniz tüm numaralar. Bu numaraları istediğiniz kurala bağlayabilirsiniz.</p>
    </div>
    <a asp-action="Create" class="btn btn-success shadow-sm fw-bold px-4">
        <i class="fas fa-plus me-2"></i>Yeni Numara Ekle
    </a>
</div>

<div class="card stat-card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted">
                        <tr>
                            <th class="ps-4">Kayıtlı Telefon Numarası</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var phone in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-success bg-opacity-10 text-success border px-3 py-2 fs-6">
                                        <i class="fas fa-phone-alt me-2"></i>@phone.PhoneNumber
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Edit" asp-route-id="@phone.Id" class="btn btn-sm btn-warning shadow-sm me-1"><i class="fas fa-pen"></i></a>
                                    <form asp-action="Delete" asp-route-id="@phone.Id" method="post" class="d-inline">
                                        <button type="button" class="btn btn-sm btn-danger shadow-sm btn-delete"><i class="fas fa-trash-alt"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                    <i class="fas fa-address-book fs-1 text-muted"></i>
                </div>
                <h5 class="text-secondary fw-bold">Rehber Boş</h5>
                <p class="text-muted">SMS gönderimi yapabilmek için rehberinize numaralar eklemelisiniz.</p>
                <a asp-action="Create" class="btn btn-outline-success mt-2">İlk Numarayı Ekle</a>
            </div>
        }
        <!-- SAYFANIN EN ALTINA EKLENECEK SCRIPT (Silme onayı ve Hata mesajı için) -->
        @section Scripts {
            @if (TempData["ErrorMessage"] != null)
            {
                <script>
                            document.addEventListener("DOMContentLoaded", function() {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'İşlem Başarısız',
                                    text: '@TempData["ErrorMessage"]',
                                    confirmButtonColor: '#10b981'
                                });
                            });
                </script>
            }

            <script>
                        $(document).ready(function() {
                            // Tablodaki form butonuna 'btn-delete' class'ı eklendiğini varsayıyoruz
                            // <button type="button" class="btn btn-sm btn-danger shadow-sm btn-delete"> yapmalısın
                            $('.btn-delete').on('click', function(e) {
                                e.preventDefault();
                                var form = $(this).closest('form');

                                Swal.fire({
                                    title: 'Numara Silinecek!',
                                    text: "Bu numarayı rehberinizden kalıcı olarak silmek istediğinize emin misiniz? (Bağlı olduğu kurallardan da koparılacaktır)",
                                    icon: 'warning',
                                    showCancelButton: true,
                                    confirmButtonColor: '#d33',
                                    cancelButtonColor: '#6c757d',
                                    confirmButtonText: '<i class="fas fa-trash me-1"></i> Evet, Sil!',
                                    cancelButtonText: 'İptal'
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        form.submit();
                                    }
                                });
                            });
                        });
            </script>
        }
    </div>
</div>