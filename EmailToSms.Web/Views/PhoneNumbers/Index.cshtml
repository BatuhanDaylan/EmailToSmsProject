@model List<EmailToSms.Web.ViewModels.PhoneNumberViewModel>
@{
    ViewData["Title"] = "SMS Numaraları";
    int ruleId = ViewBag.RuleId;
    int accountId = ViewBag.AccountId;
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <strong>Hata:</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>SMS Numaraları</h2>
        <p class="text-muted">Bu filtreye takılan e-postalar aşağıdaki numaralara SMS olarak iletilecektir.</p>
    </div>
    <div>
        <!-- Kurallar sayfasına dönerken accountId'yi geri gönderiyoruz -->
        <a asp-controller="ForwardingRules" asp-action="Index" asp-route-accountId="@accountId" class="btn btn-outline-secondary me-2">Kurallara Dön</a>

        <a asp-action="Create" asp-route-ruleId="@ruleId" asp-route-accountId="@accountId" class="btn btn-primary">Yeni Numara Ekle</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mt-3">
                    <thead class="table-light">
                        <tr>
                            <th>Telefon Numarası</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var phone in Model)
                        {
                            <tr>
                                <td class="fw-bold">@phone.PhoneNumber</td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@phone.Id" asp-route-ruleId="@ruleId" asp-route-accountId="@accountId" class="btn btn-sm btn-warning">Düzenle</a>

                                    <form asp-action="Delete" asp-route-id="@phone.Id" asp-route-ruleId="@ruleId" asp-route-accountId="@accountId" method="post" class="d-inline" onsubmit="return confirm('Bu numarayı silmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center" role="alert">
                Bu kurala henüz bir telefon numarası eklenmemiş. Sağ üstten numara ekleyebilirsiniz.
            </div>
        }
    </div>
</div>