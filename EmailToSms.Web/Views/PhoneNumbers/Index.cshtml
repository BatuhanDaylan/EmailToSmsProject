@model List<EmailToSms.Web.ViewModels.PhoneNumberViewModel>
@{
    ViewData["Title"] = "Hedef Numaralar";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1" style="letter-spacing: -0.025em;">Hedef Numaralar</h3>
        <p class="text-muted mb-0" style="font-size: 0.95rem;">Sisteme eklediğiniz tüm numaralar. Bu numaraları istediğiniz kurala bağlayabilirsiniz.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm fw-semibold">
        <i class="fas fa-plus me-2"></i>Yeni Numara Ekle
    </a>
</div>

<div class="card stat-card border-0">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th class="ps-4">Kayıtlı Telefon Numarası</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var phone in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-3 border" style="width: 36px; height: 36px;">
                                            <i class="fas fa-mobile-alt text-secondary"></i>
                                        </div>
                                        <span class="fw-semibold text-dark" style="font-family: monospace; font-size: 0.95rem;">@phone.PhoneNumber</span>
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm border rounded">
                                        <a asp-action="Edit" asp-route-id="@phone.Id" class="btn btn-sm btn-light border-0 text-secondary border-end" title="Düzenle">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@phone.Id" method="post" class="m-0">
                                            <button type="button" class="btn btn-sm btn-light border-0 text-danger btn-delete" title="Sil">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3 border" style="width: 70px; height: 70px;">
                    <i class="fas fa-address-book fs-3 text-muted"></i>
                </div>
                <h6 class="text-dark fw-bold">Rehber Boş</h6>
                <p class="text-muted small mb-4">SMS gönderimi yapabilmek için rehberinize numaralar eklemelisiniz.</p>
                <a asp-action="Create" class="btn btn-primary shadow-sm">İlk Numarayı Ekle</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                Swal.fire({
                    icon: 'error',
                    title: 'İşlem Başarısız',
                    text: '@TempData["ErrorMessage"]',
                    confirmButtonColor: '#2563eb'
                });
            });
        </script>
    }

    <script>
        $(document).ready(function() {
            $('.btn-delete').on('click', function(e) {
                e.preventDefault();
                var form = $(this).closest('form');

                Swal.fire({
                    title: 'Numara Silinecek',
                    text: "Bu numarayı kalıcı olarak silmek istediğinize emin misiniz? (Bağlı olduğu kurallardan da koparılacaktır)",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#e2e8f0',
                    confirmButtonText: 'Evet, sil',
                    cancelButtonText: '<span style="color:#334155">İptal</span>'
                }).then((result) => {
                    if (result.isConfirmed) form.submit();
                });
            });
        });
    </script>
}