@model List<EmailToSms.Web.ViewModels.PhoneNumberViewModel>
@{
    ViewData["Title"] = "Kural Atamaları";
    int ruleId = ViewBag.RuleId;
    int accountId = ViewBag.AccountId;
    var allNumbers = ViewBag.AllNumbers as List<EmailToSms.Web.ViewModels.PhoneNumberViewModel>;
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1" style="letter-spacing: -0.025em;">Hedef Numara Atamaları</h3>
        <p class="text-muted mb-0" style="font-size: 0.95rem;">Filtre tetiklendiğinde SMS gönderilecek numaraları yönetin.</p>
    </div>
    <a asp-controller="ForwardingRules" asp-action="Index" asp-route-accountId="@accountId" class="btn btn-light border text-secondary fw-semibold shadow-sm">
        <i class="fas fa-arrow-left me-1"></i> Kurallara Dön
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            Swal.fire({
                icon: 'error',
                title: 'İşlem Başarısız',
                text: '@TempData["ErrorMessage"]',
                confirmButtonColor: '#2563eb'
            });
        });
    </script>
}

<!-- Numara Ekleme Alanı -->
<div class="card stat-card border-0 mb-4 bg-light">
    <div class="card-body p-4">
        <form asp-action="Assign" method="post" class="row g-3 align-items-end">
            <input type="hidden" name="ruleId" value="@ruleId" />
            <input type="hidden" name="accountId" value="@accountId" />

            <div class="col-md-9">
                <label class="form-label text-secondary">Rehberden Numara Seçin</label>
                <select name="phoneNumberId" class="form-select border-0 shadow-sm py-2" required>
                    <option value="">-- Kurala bağlamak için bir numara seçin --</option>
                    @if (allNumbers != null && allNumbers.Any())
                    {
                        foreach (var phone in allNumbers)
                        {
                            <option value="@phone.Id">@phone.PhoneNumber</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100 shadow-sm py-2 fw-semibold">
                    <i class="fas fa-link me-2"></i>Kurala Bağla
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Bağlı Numaralar Listesi -->
<div class="card stat-card border-0">
    <div class="card-header bg-white border-bottom py-3 px-4">
        <h6 class="mb-0 fw-bold text-dark">Bu Kurala Bağlı Numaralar</h6>
    </div>
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th class="ps-4">Telefon Numarası</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var phone in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-semibold text-dark" style="font-family: monospace; font-size: 0.95rem;">@phone.PhoneNumber</span>
                                </td>
                                <td class="text-end pe-4">
                                    <form asp-action="Unassign" method="post" class="m-0 unassign-form">
                                        <input type="hidden" name="ruleId" value="@ruleId" />
                                        <input type="hidden" name="accountId" value="@accountId" />
                                        <input type="hidden" name="phoneNumberId" value="@phone.Id" />
                                        <button type="button" class="btn btn-sm btn-light border text-danger fw-semibold btn-unassign" title="Bağlantıyı Kopar">
                                            <i class="fas fa-unlink me-1"></i> Kopar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3 border" style="width: 70px; height: 70px;">
                    <i class="fas fa-unlink fs-3 text-muted"></i>
                </div>
                <h6 class="text-dark fw-bold">Bağlı Numara Yok</h6>
                <p class="text-muted small mb-0">Bu kural tetiklendiğinde SMS atılacak bir numara bulunmuyor.<br />Yukarıdaki menüden rehberinizdeki bir numarayı bağlayabilirsiniz.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.btn-unassign').on('click', function(e) {
                e.preventDefault();
                var form = $(this).closest('form');

                Swal.fire({
                    title: 'Bağlantı Koparılacak',
                    text: "Bu numara artık bu kuraldan SMS almayacak. (Rehberden kalıcı olarak silinmez)",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#e2e8f0',
                    confirmButtonText: 'Evet, kopar',
                    cancelButtonText: '<span style="color:#334155">İptal</span>'
                }).then((result) => {
                    if (result.isConfirmed) form.submit();
                });
            });
        });
    </script>
}