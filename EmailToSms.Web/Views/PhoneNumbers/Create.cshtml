@model EmailToSms.Web.ViewModels.PhoneNumberCreateViewModel
@{
    ViewData["Title"] = "Yeni Numara Ekle";
}

<div class="row justify-content-center mt-3">
    <div class="col-lg-6">
        <div class="card stat-card border-0">
            <div class="card-body p-4 p-md-5">
                <div class="mb-4">
                    <h5 class="fw-bold text-dark mb-1">Yeni SMS Hedefi</h5>
                    <p class="text-muted small">Sisteme yeni bir alıcı numarası tanımlayın.</p>
                </div>

                <div class="alert bg-light border text-muted small mb-4 d-flex align-items-center rounded-3">
                    <i class="fas fa-info-circle text-primary fs-5 me-3"></i>
                    <div>
                        Numarayı başında <strong>+</strong> işareti ve ülke kodu olacak şekilde (Örn: +905551234567) boşluk bırakmadan giriniz.
                    </div>
                </div>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3"></div>

                    <div class="mb-4">
                        <label asp-for="PhoneNumber" class="form-label">Telefon Numarası</label>
                        <input asp-for="PhoneNumber" class="form-control bg-light border-0" style="font-family: monospace;" placeholder="+905551234567" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-5 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border text-secondary fw-semibold px-4">Vazgeç</a>
                        <button type="submit" class="btn btn-primary fw-semibold px-4">Numarayı Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>