@model EmailToSms.Web.ViewModels.PhoneNumberUpdateViewModel
@{
    ViewData["Title"] = "Numarayı Güncelle";
}

<div class="row justify-content-center mt-3">
    <div class="col-lg-6">
        <div class="card stat-card border-0">
            <div class="card-body p-4 p-md-5">
                <div class="mb-4">
                    <h5 class="fw-bold text-dark mb-1">Numarayı Düzenle</h5>
                    <p class="text-muted small">Mevcut telefon numarasını güncelliyorsunuz.</p>
                </div>

                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3"></div>

                    <div class="mb-4">
                        <label asp-for="PhoneNumber" class="form-label">Telefon Numarası</label>
                        <input asp-for="PhoneNumber" class="form-control bg-light border-0" style="font-family: monospace;" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-5 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border text-secondary fw-semibold px-4">İptal</a>
                        <button type="submit" class="btn btn-primary fw-semibold px-4">Değişiklikleri Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>