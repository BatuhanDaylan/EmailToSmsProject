@model EmailToSms.Web.ViewModels.PhoneNumberUpdateViewModel
@{
    ViewData["Title"] = "Numarayı Güncelle";
    int accountId = ViewBag.AccountId;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card stat-card border-0 shadow-sm mt-3 border-top border-warning border-3">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-pen-square me-2 text-warning"></i>Numarayı Düzenle</h5>
            </div>
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ForwardingRuleId" />
                    <input type="hidden" name="accountId" value="@accountId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small mb-4"></div>

                    <div class="mb-4">
                        <label asp-for="PhoneNumber" class="form-label fw-bold text-secondary">Telefon Numarası</label>
                        <div class="input-group input-group-lg shadow-sm">
                            <span class="input-group-text bg-light border-end-0 text-warning"><i class="fas fa-mobile-alt"></i></span>
                            <input asp-for="PhoneNumber" class="form-control border-start-0 ps-0 fw-bold text-dark" />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <hr class="text-muted my-4" />

                    <div class="d-flex justify-content-end gap-3">
                        <a asp-action="Index" asp-route-ruleId="@Model.ForwardingRuleId" asp-route-accountId="@accountId" class="btn btn-light px-4 shadow-sm fw-bold text-muted">İptal</a>
                        <button type="submit" class="btn btn-warning px-4 shadow-sm fw-bold text-dark">
                            <i class="fas fa-check-circle me-2"></i>Değişiklikleri Uygula
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>