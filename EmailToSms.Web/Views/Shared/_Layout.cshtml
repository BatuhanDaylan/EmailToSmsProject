<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kurumsal SMS Gateway</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
            :root {
                /* Kurumsal Renk Paleti (Slate & Corporate Blue) */
                --bg-body: #f8fafc;
                --sidebar-bg: #0f172a;
                --sidebar-hover: #1e293b;
                --primary-color: #2563eb;
                --text-main: #334155;
                --text-muted: #64748b;
                --border-color: #e2e8f0;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--bg-body);
                color: var(--text-main);
                overflow-x: hidden;
                -webkit-font-smoothing: antialiased;
            }

            /* Modern Sidebar */
            .sidebar {
                min-height: 100vh;
                background-color: var(--sidebar-bg);
                width: 260px;
                position: fixed;
                top: 0;
                left: 0;
                z-index: 1000;
                border-right: 1px solid #1e293b;
            }

            .sidebar-brand {
                color: #ffffff;
                font-weight: 700;
                font-size: 1.25rem;
                display: flex;
                align-items: center;
                padding: 24px 20px;
                border-bottom: 1px solid #1e293b;
                text-decoration: none;
                letter-spacing: -0.025em;
            }

                .sidebar-brand i {
                    color: #38bdf8;
                }

            .sidebar-menu {
                padding: 15px 10px;
            }

            .sidebar a.nav-link {
                color: #94a3b8;
                text-decoration: none;
                padding: 12px 16px;
                display: flex;
                align-items: center;
                border-radius: 8px;
                margin-bottom: 4px;
                transition: all 0.2s ease;
                font-weight: 500;
                font-size: 0.95rem;
            }

                .sidebar a.nav-link i {
                    width: 24px;
                    font-size: 1.1rem;
                    margin-right: 10px;
                    opacity: 0.7;
                }

                .sidebar a.nav-link:hover {
                    background-color: var(--sidebar-hover);
                    color: #f1f5f9;
                }

                .sidebar a.nav-link.active {
                    background-color: rgba(37, 99, 235, 0.1);
                    color: #38bdf8;
                }

                    .sidebar a.nav-link.active i {
                        opacity: 1;
                    }

            /* Ana İçerik Alanı */
            .main-content {
                margin-left: 260px;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .top-navbar {
                background-color: #ffffff;
                border-bottom: 1px solid var(--border-color);
                padding: 15px 30px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                position: sticky;
                top: 0;
                z-index: 999;
            }

            /* Premium Kart Görünümü */
            .stat-card {
                border-radius: 12px;
                border: 1px solid var(--border-color);
                box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
                background: #ffffff;
                transition: all 0.2s ease;
            }

                .stat-card:hover {
                    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
                }

            /* Temiz Tablo Yapısı */
            .table {
                margin-bottom: 0;
            }

                .table > :not(caption) > * > * {
                    padding: 1rem 1.5rem;
                    border-bottom-color: var(--border-color);
                    color: var(--text-main);
                    vertical-align: middle;
                }

                .table thead th {
                    font-size: 0.75rem;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    color: var(--text-muted);
                    font-weight: 600;
                    background-color: #f8fafc;
                    border-bottom: 1px solid var(--border-color);
                }

            /* Form Elemanları */
            .form-control, .form-select {
                border-color: #cbd5e1;
                padding: 0.6rem 1rem;
                border-radius: 8px;
                font-size: 0.95rem;
            }

                .form-control:focus, .form-select:focus {
                    border-color: var(--primary-color);
                    box-shadow: 0 0 0 0.25rem rgba(37, 99, 235, 0.1);
                }

            .form-label {
                font-weight: 600;
                font-size: 0.85rem;
                color: var(--text-main);
                margin-bottom: 0.5rem;
            }

            /* Soft Butonlar */
            .btn {
                border-radius: 8px;
                padding: 0.5rem 1rem;
                font-weight: 500;
                font-size: 0.95rem;
                transition: all 0.15s ease;
            }

            .btn-primary {
                background-color: var(--primary-color);
                border: none;
            }

                .btn-primary:hover {
                    background-color: #1d4ed8;
                }

            .badge-soft-success {
                background-color: #dcfce7;
                color: #166534;
                padding: 0.35rem 0.6rem;
                border-radius: 6px;
                font-weight: 600;
                font-size: 0.75rem;
            }

            .badge-soft-danger {
                background-color: #fee2e2;
                color: #991b1b;
                padding: 0.35rem 0.6rem;
                border-radius: 6px;
                font-weight: 600;
                font-size: 0.75rem;
            }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
            <i class="fas fa-paper-plane me-2"></i> SmsGateway
        </a>
        <nav class="sidebar-menu">
            <a asp-controller="Home" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                <i class="fas fa-layer-group"></i> Genel Bakış
            </a>
            <a asp-controller="EmailAccounts" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "EmailAccounts" || ViewContext.RouteData.Values["Controller"]?.ToString() == "ForwardingRules" ? "active" : "")">
                <i class="fas fa-inbox"></i> E-Posta Kanalları
            </a>
            <a asp-controller="PhoneNumbers" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "PhoneNumbers" ? "active" : "")">
                <i class="fas fa-address-book"></i> Hedef Numaralar
            </a>
            <a asp-controller="Logs" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Logs" ? "active" : "")">
                <i class="fas fa-clipboard-list"></i> Sistem Logları
            </a>
        </nav>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="top-navbar">
            <h4 class="mb-0 fw-bold text-dark fs-5">@ViewData["Title"]</h4>

            <div class="d-flex align-items-center">
                <div class="d-flex align-items-center me-4">
                    <span class="position-relative d-flex h-3 w-3 me-2">
                        <span class="animate-ping position-absolute h-100 w-100 rounded-circle bg-success opacity-75" style="width: 10px; height: 10px;"></span>
                        <span class="position-relative rounded-circle bg-success" style="width: 10px; height: 10px;"></span>
                    </span>
                    <span class="text-muted small fw-semibold">Worker Aktif</span>
                </div>

                <div class="dropdown">
                    <button class="btn btn-light bg-white border text-secondary fw-semibold d-flex align-items-center" type="button" data-bs-toggle="dropdown">
                        <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-2" style="width: 28px; height: 28px; font-size: 12px;">A</div>
                        Admin
                        <i class="fas fa-chevron-down ms-2" style="font-size: 0.8rem;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                        <li>
                            <a class="dropdown-item py-2 text-danger" asp-controller="Auth" asp-action="Logout">
                                <i class="fas fa-sign-out-alt me-2"></i>Oturumu Kapat
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="container-fluid p-4 p-md-5 flex-grow-1">
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>