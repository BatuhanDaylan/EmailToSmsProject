@model List<EmailToSms.Web.ViewModels.ForwardingRuleViewModel>
@{
    ViewData["Title"] = "Filtre Kuralları";
    int currentAccountId = ViewBag.EmailAccountId;
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1" style="letter-spacing: -0.025em;">Filtre Kuralları</h3>
        <p class="text-muted mb-0" style="font-size: 0.95rem;">Seçili e-posta kanalına gelen iletiler bu kurallara göre filtrelenecektir.</p>
    </div>
    <div>
        <a asp-controller="EmailAccounts" asp-action="Index" class="btn btn-light border text-secondary fw-semibold me-2 shadow-sm">
            <i class="fas fa-arrow-left me-1"></i> Kanallara Dön
        </a>
        <a asp-action="Create" asp-route-accountId="@currentAccountId" class="btn btn-primary shadow-sm fw-semibold">
            <i class="fas fa-plus me-2"></i>Yeni Kural Ekle
        </a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            Swal.fire({
                icon: 'error',
                title: 'İşlem Başarısız',
                text: '@TempData["ErrorMessage"]',
                confirmButtonColor: '#2563eb'
            });
        });
    </script>
}

<div class="card stat-card border-0">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th class="ps-4">Gönderen (İçeriyorsa)</th>
                            <th>Konu (İçeriyorsa)</th>
                            <th>İçerik (İçeriyorsa)</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rule in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    @if (!string.IsNullOrEmpty(rule.SenderKeyword))
                                    {
                                        <span class="bg-light border text-dark px-2 py-1 rounded small fw-semibold">
                                            <i class="fas fa-at text-muted me-1"></i> @rule.SenderKeyword
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(rule.SubjectKeyword))
                                    {
                                        <span class="bg-light border text-dark px-2 py-1 rounded small fw-semibold">
                                            <i class="fas fa-heading text-muted me-1"></i> @rule.SubjectKeyword
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(rule.BodyKeyword))
                                    {
                                        <span class="bg-light border text-dark px-2 py-1 rounded small fw-semibold">
                                            <i class="fas fa-align-left text-muted me-1"></i> @rule.BodyKeyword
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm border rounded">
                                        <a asp-controller="PhoneNumbers" asp-action="RuleNumbers" asp-route-ruleId="@rule.Id" asp-route-accountId="@currentAccountId" class="btn btn-sm btn-light border-0 text-primary" title="Hedef Numaralar">
                                            <i class="fas fa-address-book"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@rule.Id" asp-route-accountId="@currentAccountId" class="btn btn-sm btn-light border-0 text-secondary border-start border-end" title="Düzenle">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@rule.Id" asp-route-accountId="@currentAccountId" method="post" class="m-0 delete-rule-form">
                                            <button type="button" class="btn btn-sm btn-light border-0 text-danger btn-delete-rule" title="Sil">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3 border" style="width: 70px; height: 70px;">
                    <i class="fas fa-code-branch fs-3 text-muted"></i>
                </div>
                <h6 class="text-dark fw-bold">Kural Bulunmuyor</h6>
                <p class="text-muted small mb-4">Bu hesaba gelen mailleri filtrelemek için henüz bir kural tanımlamadınız.</p>
                <a asp-action="Create" asp-route-accountId="@currentAccountId" class="btn btn-primary shadow-sm">İlk Kuralı Oluştur</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.btn-delete-rule').on('click', function(e) {
                e.preventDefault();
                var form = $(this).closest('form');

                Swal.fire({
                    title: 'Kural Silinecek',
                    text: "Bu kuralı ve ona bağlı hedef numara atamalarını kalıcı olarak silmek istediğinize emin misiniz?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#e2e8f0',
                    confirmButtonText: 'Evet, sil',
                    cancelButtonText: '<span style="color:#334155">İptal</span>'
                }).then((result) => {
                    if (result.isConfirmed) form.submit();
                });
            });
        });
    </script>
}