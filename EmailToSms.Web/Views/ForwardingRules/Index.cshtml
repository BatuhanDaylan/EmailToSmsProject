@model List<EmailToSms.Web.ViewModels.ForwardingRuleViewModel>
@{
    ViewData["Title"] = "Filtre Kuralları";
    int currentAccountId = ViewBag.EmailAccountId;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="text-secondary fw-bold mb-0"><i class="fas fa-filter me-2 text-info"></i>Filtre Kuralları</h3>
        <p class="text-muted mb-0 small">Seçili e-posta hesabına gelen mailler bu kurallara göre taranacaktır.</p>
    </div>
    <div>
        <a asp-controller="EmailAccounts" asp-action="Index" class="btn btn-light shadow-sm fw-bold text-muted me-2">
            <i class="fas fa-arrow-left me-1"></i> Geri Dön
        </a>
        <a asp-action="Create" asp-route-accountId="@currentAccountId" class="btn btn-info text-white shadow-sm fw-bold px-4">
            <i class="fas fa-plus me-2"></i>Yeni Kural Ekle
        </a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            Swal.fire({
                icon: 'error',
                title: 'İşlem Başarısız',
                text: '@TempData["ErrorMessage"]',
                confirmButtonColor: '#3b82f6'
            });
        });
    </script>
}

<div class="card stat-card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted">
                        <tr>
                            <th class="ps-4">Gönderen (İçeriyorsa)</th>
                            <th>Konu (İçeriyorsa)</th>
                            <th>İçerik (İçeriyorsa)</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rule in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    @if (!string.IsNullOrEmpty(rule.SenderKeyword))
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1"><i class="fas fa-user-circle me-1"></i> @rule.SenderKeyword</span>
                                    }
                                    else
                                    {

                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(rule.SubjectKeyword))
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border px-2 py-1"><i class="fas fa-heading me-1"></i> @rule.SubjectKeyword</span>
                                    }
                                    else
                                    {

                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(rule.BodyKeyword))
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-dark border px-2 py-1"><i class="fas fa-align-left me-1"></i> @rule.BodyKeyword</span>
                                    }
                                    else
                                    {

                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <!-- SMS Numaraları Butonu -->
                                    <!-- Eski hali asp-action="Index" idi, asp-action="RuleNumbers" yapıyoruz -->
                                    <a asp-controller="PhoneNumbers" asp-action="RuleNumbers" asp-route-ruleId="@rule.Id" asp-route-accountId="@currentAccountId" class="btn btn-sm btn-success shadow-sm me-1" title="SMS Numaraları">
                                        <i class="fas fa-phone-alt"></i> Numaralar
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@rule.Id" asp-route-accountId="@currentAccountId" class="btn btn-sm btn-warning shadow-sm me-1" title="Düzenle">
                                        <i class="fas fa-pen"></i>
                                    </a>

                                    <form asp-action="Delete" asp-route-id="@rule.Id" asp-route-accountId="@currentAccountId" method="post" class="d-inline delete-rule-form">
                                        <button type="button" class="btn btn-sm btn-danger shadow-sm btn-delete-rule" title="Sil">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                    <i class="fas fa-code-branch fs-1 text-muted"></i>
                </div>
                <h5 class="text-secondary fw-bold">Kural Bulunmuyor</h5>
                <p class="text-muted">Bu hesaba gelen mailleri filtrelemek için henüz bir kural tanımlamadınız.</p>
                <a asp-action="Create" asp-route-accountId="@currentAccountId" class="btn btn-outline-info mt-2">İlk Kuralı Oluştur</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.btn-delete-rule').on('click', function(e) {
                e.preventDefault();
                var form = $(this).closest('form');

                Swal.fire({
                    title: 'Kural Silinecek!',
                    text: "Bu kuralı ve ona bağlı SMS hedeflerini kalıcı olarak silmek istediğinize emin misiniz?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="fas fa-trash me-1"></i> Evet, Sil!',
                    cancelButtonText: 'İptal'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}