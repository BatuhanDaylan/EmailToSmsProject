@model EmailToSms.Web.ViewModels.ForwardingRuleCreateViewModel
@{
    ViewData["Title"] = "Yeni Kural Ekle";
}

<div class="row justify-content-center mt-3">
    <div class="col-lg-7">
        <div class="card stat-card border-0">
            <div class="card-body p-4 p-md-5">
                <div class="mb-4">
                    <h5 class="fw-bold text-dark mb-1">Yeni Filtre Kuralı</h5>
                    <p class="text-muted small">E-postaları ayıklamak için hedef kelimeleri belirleyin.</p>
                </div>

                <div class="alert bg-light border text-muted small mb-4 d-flex align-items-center rounded-3">
                    <i class="fas fa-lightbulb text-primary fs-5 me-3"></i>
                    <div>
                        Tüm alanları doldurmak zorunda değilsiniz. Sadece filtrelemek istediğiniz kriterleri doldurun, boş bıraktıklarınız dikkate alınmaz.
                    </div>
                </div>

                <form asp-action="Create" method="post">
                    <input type="hidden" asp-for="EmailAccountId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3"></div>

                    <div class="mb-4">
                        <label asp-for="SenderKeyword" class="form-label">Gönderen (İçeriyorsa)</label>
                        <input asp-for="SenderKeyword" class="form-control bg-light border-0" placeholder="Örn: muhasebe@sirket.com" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="SubjectKeyword" class="form-label">Konu (İçeriyorsa)</label>
                        <input asp-for="SubjectKeyword" class="form-control bg-light border-0" placeholder="Örn: Fatura, Acil, Sistem Uyarısı" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="BodyKeyword" class="form-label">E-Posta İçeriği (İçeriyorsa)</label>
                        <input asp-for="BodyKeyword" class="form-control bg-light border-0" placeholder="Örn: sunucu kapandı, onay kodu" />
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-5 pt-3 border-top">
                        <a asp-action="Index" asp-route-accountId="@Model.EmailAccountId" class="btn btn-light border text-secondary fw-semibold px-4">Vazgeç</a>
                        <button type="submit" class="btn btn-primary fw-semibold px-4">Kuralı Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>